# .env.example — AOE_WEB Environment Variable Template
# Copy this file to .env.local and populate with real values.
# .env.local is gitignored and must never be committed.
#
# All variables are accessed in code via import.meta.env.VITE_*
# Never destructure at module level — always read inside functions.

# Supabase — provisioned via supabase.com
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Meta WhatsApp Cloud API — provisioned via developers.facebook.com
VITE_WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
VITE_WHATSAPP_ACCESS_TOKEN=your-whatsapp-cloud-api-access-token

# Webhook verification token — arbitrary secret string (min 32 chars)
# Set during Meta webhook registration. Must match Vercel function env var.
VITE_VERIFY_TOKEN=your-webhook-verify-token
